#!/usr/bin/env python3
"""What is inside a .glb, without opening a 3D program.

A glTF binary file is a JSON document with a blob of numbers stapled to it. The JSON says
everything a decision about the asset depends on — who made it and under what licence, how many
triangles it costs, what the skeleton is called, which animations are in there and how long they
run — and none of it needs a renderer to read.

Usage:
  tools/glb info <file>...          licence, counts, geometry, skins, animation summary
  tools/glb nodes <file>            the node tree, with each mesh's size in its own units
  tools/glb skeleton <file>         the joint tree, and each joint's place in the bind pose
  tools/glb animations <file>       per clip: length, which joints move, whether it loops
  tools/glb rigs <file>...          do these skeletons match? — whose clips can drive whose model
  tools/glb strip <file>...         throw away everything but the skeleton and the clips

Both `.glb` and `.gltf` are read; a `.gltf` finds its `.bin` beside it, and data: URIs work too.

`info` takes several files, which is the way to compare two quality levels of the same download:
if their geometry lines match, they differ only in texture size and the small one is the one to
keep. See `assets/CREDITS.md` — the author and licence `info` prints come out of `asset.extras`,
which is what Sketchfab writes on export, so a credit entry can be copied rather than typed.

`rigs` answers the question a mixed pile of downloads keeps asking. Bevy binds an animation to a
skeleton by the *path* of bone names, so a clip drives a model only if the model has a bone at the
same path — and that is a thing to check before building on it, not after.

`strip` is the one command that writes. A clip downloaded with its character attached carries a
copy of the mesh and its textures, and Bevy's glTF loader builds *every* sub-asset of a file it
opens — asking for `Animation(0)` still decodes the textures and uploads them. So a 4.5 MB clip
costs 13 MB of graphics memory to hold an animation worth 50 KB. This drops the meshes, skins,
materials and images, keeps every node so the bone paths still line up, and rewrites the file in
place.

What this cannot do is show you the model. For that, see the README under "Looking at an asset".
"""

import base64
import json
import math
import os
import struct
import sys
import urllib.parse

# glTF's component types, as (struct format, size in bytes).
COMPONENTS = {
    5120: ("b", 1),
    5121: ("B", 1),
    5122: ("h", 2),
    5123: ("H", 2),
    5125: ("I", 4),
    5126: ("f", 4),
}
COUNTS = {"SCALAR": 1, "VEC2": 2, "VEC3": 3, "VEC4": 4, "MAT2": 4, "MAT3": 9, "MAT4": 16}

GLB_MAGIC = 0x46546C67
CHUNK_JSON = 0x4E4F534A
CHUNK_BIN = 0x004E4942


class Gltf:
    """A parsed glTF file: its JSON document, and the buffers the accessors point into.

    Both containers, because downloads arrive as both. A `.glb` staples the JSON and one binary
    chunk together; a `.gltf` is the same JSON as a plain file, with its buffers named by URI —
    a `.bin` beside it, or base64 inline.
    """

    def __init__(self, path):
        self.path = path
        with open(path, "rb") as handle:
            head = handle.read(4)
            handle.seek(0)
            if head == struct.pack("<I", GLB_MAGIC):
                self.json, self.buffers = self._read_glb(handle)
            else:
                self.json = json.load(handle)
                self.buffers = self._read_uris()
        if self.json is None:
            raise SystemExit(f"{path}: no JSON chunk")

    def _read_glb(self, handle):
        _magic, _version, total = struct.unpack("<III", handle.read(12))
        document = None
        blob = None
        while handle.tell() < total:
            length, kind = struct.unpack("<II", handle.read(8))
            chunk = handle.read(length)
            if kind == CHUNK_JSON:
                document = json.loads(chunk)
            elif blob is None:
                blob = chunk
        return document, [blob]

    def _read_uris(self):
        """A `.gltf`'s buffers: a file beside it, or base64 in the URI itself."""
        here = os.path.dirname(os.path.abspath(self.path))
        out = []
        for buffer in self.json.get("buffers", []):
            uri = buffer.get("uri")
            if uri is None:
                out.append(None)
            elif uri.startswith("data:"):
                out.append(base64.b64decode(uri.split(",", 1)[1]))
            else:
                beside = os.path.join(here, urllib.parse.unquote(uri))
                if not os.path.exists(beside):
                    raise SystemExit(f"{self.path}: needs {uri}, which is not beside it")
                with open(beside, "rb") as data:
                    out.append(data.read())
        return out

    def get(self, key):
        return self.json.get(key, [])

    def name(self, index):
        return self.get("nodes")[index].get("name") or f"<node {index}>"

    def read(self, accessor):
        """One accessor's values, as a list of tuples."""
        spec = self.get("accessors")[accessor]
        view = self.get("bufferViews")[spec["bufferView"]]
        start = view.get("byteOffset", 0) + spec.get("byteOffset", 0)
        fmt, size = COMPONENTS[spec["componentType"]]
        width = COUNTS[spec["type"]]
        stride = view.get("byteStride") or size * width
        blob = self.buffers[view.get("buffer", 0)]
        return [
            struct.unpack_from("<" + fmt * width, blob, start + i * stride)
            for i in range(spec["count"])
        ]

    def bytes_of(self, accessor):
        """One accessor's values as raw bytes, packed tight — no stride, no offset.

        `read` turns them into numbers, which is what a question about an asset needs. This keeps
        them as they are, which is what copying one into a new file needs: a float that has been
        through Python is a float that has been rounded.
        """
        spec = self.get("accessors")[accessor]
        if "sparse" in spec:
            raise SystemExit(f"{self.path}: sparse accessors are not handled")
        view = self.get("bufferViews")[spec["bufferView"]]
        start = view.get("byteOffset", 0) + spec.get("byteOffset", 0)
        _fmt, size = COMPONENTS[spec["componentType"]]
        width = size * COUNTS[spec["type"]]
        stride = view.get("byteStride") or width
        blob = self.buffers[view.get("buffer", 0)]
        return b"".join(
            blob[start + i * stride : start + i * stride + width] for i in range(spec["count"])
        )

    def parents(self):
        out = {}
        for index, node in enumerate(self.get("nodes")):
            for child in node.get("children", []):
                out[child] = index
        return out


def info(paths):
    for path in paths:
        glb = Gltf(path)
        extras = glb.json.get("asset", {}).get("extras") or {}
        print("=" * 78)
        print(path)
        print("=" * 78)
        if extras:
            for key in ("title", "author", "license", "source"):
                if extras.get(key):
                    print(f"{key:10} {extras[key]}")
        else:
            print("no asset.extras — this file carries no author or licence of its own")
        print(f"{'generator':10} {glb.json.get('asset', {}).get('generator')}")

        vertices = triangles = skinned = 0
        for mesh in glb.get("meshes"):
            for primitive in mesh.get("primitives", []):
                attributes = primitive.get("attributes", {})
                if "POSITION" in attributes:
                    vertices += glb.get("accessors")[attributes["POSITION"]]["count"]
                if "JOINTS_0" in attributes:
                    skinned += 1
                if "indices" in primitive:
                    triangles += glb.get("accessors")[primitive["indices"]]["count"] // 3
        print()
        print(f"{'geometry':10} {vertices} vertices, {triangles} triangles"
              f"{f', {skinned} skinned primitives' if skinned else ''}")
        print(f"{'meshes':10} " + ", ".join(
            f"{mesh.get('name') or '<unnamed>'}" for mesh in glb.get("meshes")) or "none")
        print(f"{'materials':10} {len(glb.get('materials'))}, "
              f"{len(glb.get('textures'))} textures, {len(glb.get('images'))} images")
        sizes = _image_sizes(glb)
        if sizes:
            budget = sum(w * h * 4 * 4 // 3 for w, h in sizes) / (1024 * 1024)
            biggest = max(sizes, key=lambda size: size[0] * size[1])
            widest = f"{biggest[0]}x{biggest[1]}"
            print(f"{'texture':10} largest {widest}, ~{budget:.0f} MB of GPU memory")

        for index, skin in enumerate(glb.get("skins")):
            print(f"{'skin ' + str(index):10} {len(skin.get('joints', []))} joints")

        clips = glb.get("animations")
        print(f"{'animations':10} {len(clips)}")
        for index, clip in enumerate(clips):
            print(f"           {index:3} {clip.get('name') or '<unnamed>':32} "
                  f"{_duration(glb, clip):6.2f} s, {len(clip.get('channels', []))} channels")
        print()


def _image_sizes(glb):
    """Every image's pixel dimensions, read from the file header rather than decoded.

    Texture memory is what a GPU actually runs out of, and it has nothing to do with how big the
    file is: a PNG that compresses to 1 MB still costs `w * h * 4` bytes uploaded, plus a third
    again for its mip chain. A 2048-square map is 21 MB whatever it weighs on disk. This is here
    because that arithmetic took a laptop down twice before anybody did it.
    """
    out = []
    for image in glb.get("images"):
        if "bufferView" in image:
            view = glb.get("bufferViews")[image["bufferView"]]
            blob = glb.buffers[view.get("buffer", 0)]
            start = view.get("byteOffset", 0)
            head = blob[start : start + view["byteLength"]]
        elif image.get("uri", "").startswith("data:"):
            head = base64.b64decode(image["uri"].split(",", 1)[1])
        else:
            beside = os.path.join(
                os.path.dirname(os.path.abspath(glb.path)),
                urllib.parse.unquote(image.get("uri", "")),
            )
            if not os.path.exists(beside):
                continue
            with open(beside, "rb") as data:
                head = data.read()
        size = _png_size(head) or _jpeg_size(head)
        if size:
            out.append(size)
    return out


def _png_size(data):
    if data[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    return struct.unpack(">II", data[16:24])


def _jpeg_size(data):
    """JPEG keeps its dimensions in a start-of-frame marker, which is not at a fixed offset."""
    if data[:2] != b"\xff\xd8":
        return None
    at = 2
    while at + 9 < len(data):
        if data[at] != 0xFF:
            at += 1
            continue
        marker = data[at + 1]
        if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
            height, width = struct.unpack(">HH", data[at + 5 : at + 9])
            return width, height
        at += 2 + struct.unpack(">H", data[at + 2 : at + 4])[0] if at + 4 <= len(data) else 2
    return None


def _duration(glb, clip):
    longest = 0.0
    for sampler in clip.get("samplers", []):
        end = glb.get("accessors")[sampler["input"]].get("max")
        if end:
            longest = max(longest, end[0])
    return longest


def nodes(path):
    glb = Gltf(path)
    scene = glb.get("scenes")[glb.json.get("scene", 0)]
    meshes = glb.get("meshes")
    accessors = glb.get("accessors")

    def walk(index, depth):
        node = glb.get("nodes")[index]
        line = "  " * depth + glb.name(index)
        if "mesh" in node:
            sizes = []
            for primitive in meshes[node["mesh"]].get("primitives", []):
                spec = accessors[primitive["attributes"]["POSITION"]]
                size = [high - low for low, high in zip(spec["min"], spec["max"])]
                sizes.append(f"{size[0]:.2f} x {size[1]:.2f} x {size[2]:.2f}")
            line = f"{line:<44} mesh: " + "; ".join(sizes)
        print(line)
        for child in node.get("children", []):
            walk(child, depth + 1)

    for root in scene["nodes"]:
        walk(root, 0)


def skeleton(path):
    glb = Gltf(path)
    if not glb.get("skins"):
        raise SystemExit(f"{path}: no skin, so nothing here is a skeleton")
    parents = glb.parents()
    for index, skin in enumerate(glb.get("skins")):
        joints = skin["joints"]
        places = _bind_positions(glb, skin)
        print(f"skin {index}: {len(joints)} joints")
        for root in (j for j in joints if parents.get(j) not in set(joints)):
            _walk_joints(glb, root, set(joints), places, 0)
        print()


def _bind_positions(glb, skin):
    """Where each joint sits in the bind pose, from the inverse bind matrices.

    A joint's bind matrix is the inverse of the matrix stored here, and the translation of a
    rigid transform's inverse is `-R^T t` — so the joint's place comes back without inverting a
    4x4 by hand. Scale in the rig would skew this; it is a sanity check, not a measurement.
    """
    if "inverseBindMatrices" not in skin:
        return {}
    out = {}
    for joint, m in zip(skin["joints"], glb.read(skin["inverseBindMatrices"])):
        rows = [(m[0], m[4], m[8]), (m[1], m[5], m[9]), (m[2], m[6], m[10])]
        t = (m[12], m[13], m[14])
        out[joint] = tuple(
            -sum(rows[r][i] * t[r] for r in range(3)) for i in range(3)
        )
    return out


def _walk_joints(glb, index, joints, places, depth):
    place = places.get(index)
    line = "  " * depth + glb.name(index)
    if place:
        line = f"{line:<52} ({place[0]:8.1f}, {place[1]:8.1f}, {place[2]:8.1f})"
    print(line)
    for child in glb.get("nodes")[index].get("children", []):
        if child in joints:
            _walk_joints(glb, child, joints, places, depth + 1)


def animations(path):
    glb = Gltf(path)
    clips = glb.get("animations")
    if not clips:
        raise SystemExit(f"{path}: no animations")
    for index, clip in enumerate(clips):
        print("=" * 78)
        print(f"{index}: {clip.get('name') or '<unnamed>'}   {_duration(glb, clip):.2f} s, "
              f"{len(clip.get('channels', []))} channels")
        print("=" * 78)

        moving = []
        still = 0
        loops = 0
        for channel in clip.get("channels", []):
            sampler = clip["samplers"][channel["sampler"]]
            values = glb.read(sampler["output"])
            target = channel["target"]
            span = max(
                max(abs(value[i] - values[0][i]) for i in range(len(value)))
                for value in values
            )
            if span < 1e-6:
                still += 1
                continue
            ends = max(abs(a - b) for a, b in zip(values[0], values[-1]))
            loops += ends < span * 0.02
            moving.append((span, glb.name(target["node"]), target["path"], len(values)))

        moving.sort(reverse=True)
        travel = _travel(glb, clip)
        if travel is not None:
            distance, speed = travel
            print(f"travels {distance:.2f} m, {speed:.2f} m/s — the speed the feet are pacing for")
        print(f"{len(moving)} channels move, {still} never do; "
              f"{loops} of the moving ones end where they started")
        print(f"  {'span':>9}  {'joint':36} {'path':12} keys")
        for span, name, kind, keys in moving[:20]:
            print(f"  {span:9.3f}  {name:36} {kind:12} {keys}")
        if len(moving) > 20:
            print(f"  ... and {len(moving) - 20} more")
        print()


def _joint_paths(glb):
    """Every bone's path of names, from the scene root down.

    Paths rather than bare names, because that is what Bevy matches on: an `AnimationTargetId` is
    a hash of the chain of names from the scene root to the bone. Two rigs that use the same names
    in a different hierarchy do not interchange, and comparing name sets would say they do.

    From the *scene root*, not from the skeleton's, because that is where the loader starts — a
    wrapper node above the skeleton is part of every path under it. And every named node, not only
    the skinned joints, because a clip-only file carries no skin at all: an animation pack is a
    bone tree and some curves, and refusing to compare it would refuse the commonest case there is.
    """
    parents = glb.parents()
    out = {}
    for index in range(len(glb.get("nodes"))):
        chain = []
        walker = index
        while walker is not None:
            chain.append(glb.name(walker))
            walker = parents.get(walker)
        out["/".join(reversed(chain))] = index
    return out


def _travel(glb, clip):
    """How far the clip carries the figure, and how fast.

    Root motion: a locomotion clip made with it advances the root bone, and that displacement over
    the clip's length is the speed the stride was authored for. It is what foot lock needs — play a
    walk at a different ground speed and the feet skate — and a clip exported with root motion
    stripped reports nothing here, which is itself the answer to "which variant is this".
    """
    for wanted in ("root", "pelvis", "mixamorig:Hips"):
        for channel in clip.get("channels", []):
            target = channel["target"]
            if target["path"] != "translation" or glb.name(target["node"]) != wanted:
                continue
            values = glb.read(clip["samplers"][channel["sampler"]]["output"])
            first, last = values[0], values[-1]
            distance = math.hypot(last[0] - first[0], last[2] - first[2])
            seconds = _duration(glb, clip)
            if distance < 1e-4 or seconds <= 0.0:
                return None
            return distance, distance / seconds
    return None


def rigs(paths):
    """Whether these skeletons are the same one, and so whose clips can drive whose model."""
    rigged = []
    for path in paths:
        glb = Gltf(path)
        found = _joint_paths(glb)
        if not found:
            print(f"{os.path.basename(path):44} no nodes at all")
            continue
        joints = sum(len(skin.get("joints", [])) for skin in glb.get("skins"))
        clips = len(glb.get("animations"))
        meshes = sum(
            1
            for mesh in glb.get("meshes")
            for primitive in mesh.get("primitives", [])
            if "JOINTS_0" in primitive.get("attributes", {})
        )
        print(f"{os.path.basename(path):44} {len(found):3} nodes ({joints} skinned), "
              f"{clips:3} clips, {meshes} skinned mesh{'es' if meshes != 1 else ''}")
        rigged.append((path, found))

    if len(rigged) < 2:
        return
    reference, theirs = rigged[0]
    print(f"\nagainst {os.path.basename(reference)}:")
    for path, mine in rigged[1:]:
        missing = set(theirs) - set(mine)
        extra = set(mine) - set(theirs)
        shared = set(theirs) & set(mine)
        if not missing and not extra:
            verdict = "identical — clips interchange with nothing to do"
        elif not missing:
            verdict = "a superset — the reference's clips drive this, the extra bones stay put"
        elif not shared:
            verdict = "nothing in common — retargeting, not a wiring problem"
        else:
            verdict = f"{len(shared)} shared, {len(missing)} missing — clips would drive it in part"
        print(f"  {os.path.basename(path):42} {verdict}")
        for name in sorted(missing)[:4]:
            print(f"      missing: {name}")
        for name in sorted(extra)[:4]:
            print(f"      extra:   {name}")


def strip(paths):
    """Rewrite each file with its meshes and textures gone, keeping the skeleton and the clips.

    In place, because these files are the *output* of a conversion — `tools/setup-assets` makes
    them again from the download at any time — and a `.stripped.glb` beside every clip would be one
    more thing for the loader to pick the wrong one of.
    """
    for path in paths:
        glb = Gltf(path)
        if not glb.get("animations"):
            raise SystemExit(f"{path}: no animations — stripping it would leave nothing")
        before = os.path.getsize(path)
        document, blob = _clips_only(glb)
        _write_glb(path, document, blob)
        after = os.path.getsize(path)
        print(f"  {os.path.basename(path):32} {before / 1e6:6.2f} MB -> {after / 1e6:6.2f} MB")


def _clips_only(glb):
    """The same file with only what an animation needs: the nodes, and the curves that move them.

    Every node is kept, including the ones that only ever held a mesh. Bevy binds a clip to a
    skeleton by the *path* of names down from the scene root, so a node dropped out of the middle
    would rename everything below it — and `rigs` would then report a mismatch that is this
    command's own doing.
    """
    document = {"asset": glb.json.get("asset", {"version": "2.0"})}
    for key in ("scene", "scenes"):
        if key in glb.json:
            document[key] = glb.json[key]
    document["nodes"] = [
        {key: value for key, value in node.items() if key not in ("mesh", "skin")}
        for node in glb.get("nodes")
    ]

    accessors, views, blob, moved = [], [], bytearray(), {}

    def keep(index):
        """Copy one accessor across, once, and say where it landed."""
        if index not in moved:
            data = glb.bytes_of(index)
            # glTF wants a view's offset aligned to its component size; four covers every type
            # an animation sampler uses.
            blob.extend(b"\0" * (-len(blob) % 4))
            views.append({"buffer": 0, "byteOffset": len(blob), "byteLength": len(data)})
            blob.extend(data)
            spec = dict(glb.get("accessors")[index])
            spec["bufferView"] = len(views) - 1
            spec.pop("byteOffset", None)
            moved[index] = len(accessors)
            accessors.append(spec)
        return moved[index]

    document["animations"] = [
        {
            **clip,
            "samplers": [
                {**sampler, "input": keep(sampler["input"]), "output": keep(sampler["output"])}
                for sampler in clip["samplers"]
            ],
        }
        for clip in glb.get("animations")
    ]
    document["accessors"] = accessors
    document["bufferViews"] = views
    document["buffers"] = [{"byteLength": len(blob)}]
    return document, bytes(blob)


def _write_glb(path, document, blob):
    """Two chunks and a header. Written beside the target and moved over it, so an interrupted
    run leaves the old file rather than half a new one."""
    text = json.dumps(document, separators=(",", ":")).encode()
    text += b" " * (-len(text) % 4)
    blob += b"\0" * (-len(blob) % 4)
    beside = path + ".new"
    with open(beside, "wb") as out:
        out.write(struct.pack("<III", GLB_MAGIC, 2, 12 + 8 + len(text) + 8 + len(blob)))
        out.write(struct.pack("<II", len(text), CHUNK_JSON))
        out.write(text)
        out.write(struct.pack("<II", len(blob), CHUNK_BIN))
        out.write(blob)
    os.replace(beside, path)


COMMANDS = {
    "info": info,
    "nodes": nodes,
    "skeleton": skeleton,
    "animations": animations,
    "rigs": rigs,
    "strip": strip,
}


def main():
    args = sys.argv[1:]
    if len(args) < 2 or args[0] not in COMMANDS:
        raise SystemExit(__doc__)
    command, files = args[0], args[1:]
    if command in ("info", "rigs", "strip"):
        COMMANDS[command](files)
    else:
        if len(files) != 1:
            raise SystemExit(f"{command} takes one file")
        COMMANDS[command](files[0])


if __name__ == "__main__":
    main()
