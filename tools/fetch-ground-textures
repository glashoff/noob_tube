#!/usr/bin/env python3
"""Fetches ambientCG's ground materials so there is something to choose a layer from.

The three textures this repository ships were picked by hand out of ambientCG's Ground category,
which has grown to well over a hundred packs. Picking the fourth means looking at them, and looking
at them means having them on disk — but a hundred colour maps is a third of a gigabyte, which is
not something to commit to keep one of them. So this brings them down instead, and `.gitignore`
leaves them where they land: `/assets/textures/*` is ignored, and each file that ships is let
through by name.

    tools/fetch-ground-textures                    # 1K PNG colour maps, the whole Ground category
    tools/fetch-ground-textures --dry-run          # what it would fetch, and how much traffic
    tools/fetch-ground-textures --category Grass   # any other ambientCG category
    tools/fetch-ground-textures --maps all         # normal, roughness, displacement, AO as well

The defaults are chosen so a fetched pack is usable without renaming anything:
`client/src/ground_material.rs` builds its path as `textures/{name}_Color.png`, so a 1K PNG colour
map landing as `assets/textures/Ground108_1K-PNG_Color.png` is reached by putting `Ground108_1K-PNG`
in a layer's `texture` field and nothing else. Colour maps only, for the same reason the shipped
ones are colour only: the ground mesh carries no tangents, so a normal map has nothing to hang on.

ambientCG serves whole packs and nothing smaller — one zip per resolution, every map inside it — so
a colour map costs the download of its five siblings whether they are kept or not. That is where
the traffic goes, and why this runs slowly on purpose: a pause between packs, a backoff when the
server says to slow down, and every pack already on disk skipped, so an interrupted run continues
where it stopped rather than starting over.

Everything on ambientCG is CC0 — a public-domain dedication, no conditions. Should one of these end
up shipping, add it to `.gitignore` by name and give it an entry in `assets/CREDITS.md` beside the
three that are already there.
"""

from __future__ import annotations

import argparse
import json
import random
import shutil
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

API = "https://ambientcg.com/api/v2/full_json"
# ambientCG asks for a User-Agent that says who is calling, so that a misbehaving script can be
# told apart from a browser and, if it comes to it, mailed rather than blocked.
AGENT = "my_bevy_game/tools/fetch-ground-textures (+https://ambientcg.com/, contact via repo)"
ROOT = Path(__file__).resolve().parent.parent

# The maps a pack contains, under ambientCG's own suffixes. `Color` is the default because it is
# the only one the ground shader reads; the rest are here so `--maps` can name them.
MAPS = ["Color", "NormalGL", "NormalDX", "Roughness", "Displacement", "AmbientOcclusion"]


def die(message: str) -> None:
    print(f"\033[31m{message}\033[0m", file=sys.stderr)
    sys.exit(1)


def get(url: str, tries: int = 5) -> bytes:
    """One GET, retried with a growing wait — and a longer one when the server asks for it.

    A run of this is a hundred-odd requests for ten megabytes each, which is exactly the shape of
    traffic a rate limiter exists to stop. 429 and 503 are the polite forms of "slow down" and are
    answered by waiting, honouring `Retry-After` when it is sent; a 404 is a fact about the file
    and is not retried.
    """
    wait = 30.0
    for attempt in range(1, tries + 1):
        request = urllib.request.Request(url, headers={"User-Agent": AGENT})
        try:
            with urllib.request.urlopen(request, timeout=120) as response:
                return response.read()
        except urllib.error.HTTPError as error:
            if error.code in (404, 410):
                raise
            pause = wait
            if error.code == 429:
                header = error.headers.get("Retry-After", "")
                if header.strip().isdigit():
                    pause = max(wait, float(header))
            reason = f"HTTP {error.code}"
        except (urllib.error.URLError, TimeoutError, ConnectionError) as error:
            pause, reason = wait, str(error)
        if attempt == tries:
            raise RuntimeError(f"{reason}, and that was attempt {tries} of {tries}")
        print(f"    {reason} — waiting {pause:.0f}s, then attempt {attempt + 1} of {tries}")
        time.sleep(pause)
        wait *= 2
    raise AssertionError("unreachable")


def catalogue(category: str, sort: str) -> list[dict]:
    """Every material in a category, in pages, because the API caps a page at 100."""
    assets: list[dict] = []
    while True:
        query = urllib.parse.urlencode(
            {
                "type": "Material",
                "category": category,
                "sort": sort,
                "limit": 100,
                "offset": len(assets),
                "include": "downloadData",
            }
        )
        page = json.loads(get(f"{API}?{query}"))
        found = page.get("foundAssets") or []
        assets += found
        if len(assets) >= page.get("numberOfResults", 0) or not found:
            return assets


def zip_for(asset: dict, attribute: str) -> dict | None:
    """The one download of a pack matching e.g. `1K-PNG`, or nothing if it has none.

    A few assets carry no downloads at all — the ones still inside their early-access window, whose
    `downloadFiletypeCategories` comes back as an empty list rather than an object. Walking the
    structure rather than indexing into it keeps that from being a crash.
    """
    def walk(node):
        if isinstance(node, dict):
            if node.get("attribute") == attribute and node.get("filetype") == "zip":
                yield node
            for value in node.values():
                yield from walk(value)
        elif isinstance(node, list):
            for value in node:
                yield from walk(value)

    return next(walk(asset.get("downloadFolders") or {}), None)


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--category", default="Ground", help="ambientCG category (default: Ground)")
    parser.add_argument(
        "--resolution", default="1K", choices=["1K", "2K", "4K", "8K"], help="default: 1K"
    )
    parser.add_argument("--format", default="PNG", choices=["PNG", "JPG"], help="default: PNG")
    parser.add_argument(
        "--maps",
        default="Color",
        help="comma-separated maps to keep, or `all` (default: Color; known: " + ", ".join(MAPS) + ")",
    )
    parser.add_argument(
        "--out", type=Path, default=ROOT / "assets" / "textures", help="default: assets/textures"
    )
    parser.add_argument(
        "--pause",
        type=float,
        default=8.0,
        help="seconds between packs, jittered by a quarter either way (default: 8)",
    )
    parser.add_argument("--limit", type=int, help="stop after this many packs (the most popular)")
    parser.add_argument(
        "--sort", default="Popular", choices=["Popular", "Latest", "Alphabet", "Downloads"]
    )
    parser.add_argument("--dry-run", action="store_true", help="list and total, download nothing")
    args = parser.parse_args()

    wanted = MAPS if args.maps.strip().lower() == "all" else [m.strip() for m in args.maps.split(",")]
    unknown = [m for m in wanted if m not in MAPS]
    if unknown:
        die(f"Not a map name: {', '.join(unknown)}\nKnown: {', '.join(MAPS)}")

    attribute = f"{args.resolution}-{args.format}"
    suffix = args.format.lower()

    print(f"Asking ambientCG for the {args.category} materials…")
    assets = catalogue(args.category, args.sort)
    if not assets:
        die(f"No materials in category {args.category!r}. The category names are the ones in the\n"
            f"sidebar at https://ambientcg.com/list — Ground, Grass, Rock, Concrete, and so on.")
    if args.limit:
        assets = assets[: args.limit]

    args.out.mkdir(parents=True, exist_ok=True)

    # Three buckets, decided before anything is downloaded so the plan can be printed: packs to
    # fetch, packs already on disk, and packs the site has nothing to give at this attribute.
    todo, have, missing = [], [], []
    for asset in assets:
        name = f"{asset['assetId']}_{attribute}"
        if all((args.out / f"{name}_{m}.{suffix}").exists() for m in wanted):
            have.append(name)
            continue
        download = zip_for(asset, attribute)
        (todo if download else missing).append((asset["assetId"], name, download))

    traffic = sum(d["size"] for _, _, d in todo)
    print(
        f"{len(assets)} materials: {len(todo)} to fetch ({traffic / 1e9:.2f} GB of zips), "
        f"{len(have)} already here, {len(missing)} with no {attribute} download."
    )
    if missing:
        print("  no download: " + ", ".join(i for i, _, _ in missing))
    if args.dry_run:
        for _, name, download in todo:
            print(f"  {name}  {download['size'] / 1e6:6.1f} MB")
        return
    if not todo:
        print("Nothing to do.")
        return
    minutes = (len(todo) * args.pause) / 60
    print(f"Keeping {', '.join(wanted)} from each. At least {minutes:.0f} min of pauses alone.\n")

    kept = 0
    with tempfile.TemporaryDirectory(prefix="ambientcg-") as scratch:
        archive = Path(scratch) / "pack.zip"
        for index, (asset_id, name, download) in enumerate(todo, 1):
            head = f"[{index}/{len(todo)}] {name}  ({download['size'] / 1e6:.1f} MB)"
            print(head, end="", flush=True)
            try:
                archive.write_bytes(get(download["downloadLink"]))
            except (urllib.error.HTTPError, RuntimeError) as error:
                print(f"\n    skipped: {error}")
                continue

            # A pack whose zip does not hold the maps it was fetched for is worth saying out loud
            # rather than counting as done: it means ambientCG's naming has moved, and the next run
            # would fetch it all over again.
            written = []
            with zipfile.ZipFile(archive) as pack:
                inside = {Path(n).name: n for n in pack.namelist()}
                for wants in wanted:
                    member = inside.get(f"{name}_{wants}.{suffix}")
                    if member is None:
                        print(f"\n    no {wants} map inside — pack holds: {', '.join(sorted(inside))}")
                        continue
                    target = args.out / f"{name}_{wants}.{suffix}"
                    with pack.open(member) as source, open(target, "wb") as sink:
                        shutil.copyfileobj(source, sink)
                    written.append(target)
            kept += len(written)
            print(f" -> {', '.join(p.name for p in written) or 'nothing'}")

            if index < len(todo):
                time.sleep(args.pause * random.uniform(0.75, 1.25))

    print(f"\nDone: {kept} files in {args.out}.")
    print("All CC0. A layer reads one by name, without the _Color suffix, e.g. "
          f"texture = \"{todo[0][1]}\".")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nStopped. Re-run to continue: what is on disk is skipped.")
        sys.exit(130)
