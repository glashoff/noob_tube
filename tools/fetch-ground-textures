#!/usr/bin/env python3
"""Fetches ambientCG's ground materials so there is something to choose a layer from.

The three textures this repository ships were picked by hand out of ambientCG's Ground category,
which has grown to well over a hundred packs. Picking the fourth means looking at them, and looking
at them means having them on disk — but a hundred packs is two gigabytes, which is not something to
commit in order to keep one of them. So this brings them down instead, and `.gitignore` leaves them
where they land: `/downloads/` for the packs, and `/assets/textures/*` for what is unpacked out of
them, where each file that ships is let through by name.

    tools/fetch-ground-textures                    # 1K PNG colour maps, the whole Ground category
    tools/fetch-ground-textures --dry-run          # what it would fetch, and how much traffic
    tools/fetch-ground-textures --maps all         # normal, roughness, displacement, AO as well
    tools/fetch-ground-textures --category Grass   # any other ambientCG category

The defaults are chosen so a fetched pack is usable without renaming anything:
`client/src/ground_material.rs` builds its path as `textures/{name}_Color.png`, so a 1K PNG colour
map landing as `assets/textures/Ground108_1K-PNG_Color.png` is reached by putting `Ground108_1K-PNG`
in a layer's `texture` field and nothing else.

**The zips are kept, and that is the point of the layout.** ambientCG serves whole packs and
nothing smaller — one zip per resolution, every map inside it — so a colour map costs the download
of its five siblings whether they are unpacked or not. Throwing them away would mean paying that
traffic again the day the ground mesh grows tangents and a normal map becomes worth having. With
the packs in `downloads/`, changing your mind is local: a second run with `--maps all` re-opens what
is already on disk, downloads nothing, and does not pause. `--no-packs` discards them if the disk
matters more than the choice.

Downloading runs slowly on purpose: a jittered pause between packs, a backoff when the server says
to slow down, and any pack already in `downloads/` taken from there, so an interrupted run
continues where it stopped rather than starting over.

Everything on ambientCG is CC0 — a public-domain dedication, no conditions. Should one of these end
up shipping, add it to `.gitignore` by name and give it an entry in `assets/CREDITS.md` beside the
three that are already there.
"""

from __future__ import annotations

import argparse
import json
import random
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zipfile
from pathlib import Path

API = "https://ambientcg.com/api/v2/full_json"
# ambientCG asks for a User-Agent that says who is calling, so that a misbehaving script can be
# told apart from a browser and, if it comes to it, mailed rather than blocked.
AGENT = "my_bevy_game/tools/fetch-ground-textures (+https://ambientcg.com/, contact via repo)"
ROOT = Path(__file__).resolve().parent.parent

# The maps a pack contains, under ambientCG's own suffixes. `Color` is the default because it is
# the only one the ground shader reads; the rest are here so `--maps` can name them.
MAPS = ["Color", "NormalGL", "NormalDX", "Roughness", "Displacement", "AmbientOcclusion"]


def die(message: str) -> None:
    print(f"\033[31m{message}\033[0m", file=sys.stderr)
    sys.exit(1)


def get(url: str, into: Path | None = None, tries: int = 5) -> bytes:
    """One GET, retried with a growing wait — and a longer one when the server asks for it.

    A run of this is a hundred-odd requests for twenty megabytes each, which is exactly the shape
    of traffic a rate limiter exists to stop. 429 and 503 are the polite forms of "slow down" and
    are answered by waiting, honouring `Retry-After` when it is sent; a 404 is a fact about the
    file and is not retried.

    With `into`, the body is streamed to that path through a `.part` beside it, so a download cut
    off halfway leaves nothing that a later run could mistake for a whole pack.
    """
    wait = 30.0
    for attempt in range(1, tries + 1):
        request = urllib.request.Request(url, headers={"User-Agent": AGENT})
        try:
            with urllib.request.urlopen(request, timeout=120) as response:
                if into is None:
                    return response.read()
                part = into.with_suffix(into.suffix + ".part")
                with open(part, "wb") as sink:
                    shutil.copyfileobj(response, sink)
                part.replace(into)
                return b""
        except urllib.error.HTTPError as error:
            if error.code in (404, 410):
                raise
            pause = wait
            if error.code == 429:
                header = error.headers.get("Retry-After", "")
                if header.strip().isdigit():
                    pause = max(wait, float(header))
            reason = f"HTTP {error.code}"
        except (urllib.error.URLError, TimeoutError, ConnectionError) as error:
            pause, reason = wait, str(error)
        if attempt == tries:
            raise RuntimeError(f"{reason}, and that was attempt {tries} of {tries}")
        print(f"\n    {reason} — waiting {pause:.0f}s, then attempt {attempt + 1} of {tries}")
        time.sleep(pause)
        wait *= 2
    raise AssertionError("unreachable")


def catalogue(category: str, sort: str) -> list[dict]:
    """Every material in a category, in pages, because the API caps a page at 100."""
    assets: list[dict] = []
    while True:
        query = urllib.parse.urlencode(
            {
                "type": "Material",
                "category": category,
                "sort": sort,
                "limit": 100,
                "offset": len(assets),
                "include": "downloadData",
            }
        )
        page = json.loads(get(f"{API}?{query}"))
        found = page.get("foundAssets") or []
        assets += found
        if len(assets) >= page.get("numberOfResults", 0) or not found:
            return assets


def zip_for(asset: dict, attribute: str) -> dict | None:
    """The one download of a pack matching e.g. `1K-PNG`, or nothing if it has none.

    A few assets carry no downloads at all — the ones still inside their early-access window, whose
    `downloadFiletypeCategories` comes back as an empty list rather than an object. Walking the
    structure rather than indexing into it keeps that from being a crash.
    """
    def walk(node):
        if isinstance(node, dict):
            if node.get("attribute") == attribute and node.get("filetype") == "zip":
                yield node
            for value in node.values():
                yield from walk(value)
        elif isinstance(node, list):
            for value in node:
                yield from walk(value)

    return next(walk(asset.get("downloadFolders") or {}), None)


def unpack(archive: Path, name: str, wanted: list[str], suffix: str, out: Path) -> list[Path]:
    """Copies the wanted maps out of one pack, and says which it could not find.

    A pack that does not hold a map it was fetched for is worth saying out loud rather than passing
    over: it means ambientCG's naming has moved, and every later run would go looking again.
    """
    written = []
    with zipfile.ZipFile(archive) as pack:
        inside = {Path(n).name: n for n in pack.namelist()}
        for wants in wanted:
            member = inside.get(f"{name}_{wants}.{suffix}")
            if member is None:
                print(f"\n    no {wants} map inside — pack holds: {', '.join(sorted(inside))}")
                continue
            target = out / f"{name}_{wants}.{suffix}"
            with pack.open(member) as source, open(target, "wb") as sink:
                shutil.copyfileobj(source, sink)
            written.append(target)
    return written


def main() -> None:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--category", default="Ground", help="ambientCG category (default: Ground)")
    parser.add_argument(
        "--resolution", default="1K", choices=["1K", "2K", "4K", "8K"], help="default: 1K"
    )
    parser.add_argument("--format", default="PNG", choices=["PNG", "JPG"], help="default: PNG")
    parser.add_argument(
        "--maps",
        default="Color",
        help="comma-separated maps to unpack, or `all` (default: Color; known: "
        + ", ".join(MAPS)
        + "). Re-running with more costs no traffic while the packs are kept.",
    )
    parser.add_argument(
        "--out", type=Path, default=ROOT / "assets" / "textures", help="default: assets/textures"
    )
    parser.add_argument(
        "--packs",
        type=Path,
        default=ROOT / "downloads" / "ambientcg",
        help="where the zips are kept (default: downloads/ambientcg)",
    )
    parser.add_argument(
        "--no-packs",
        action="store_true",
        help="delete each zip once unpacked — then a later --maps costs the traffic again",
    )
    parser.add_argument(
        "--pause",
        type=float,
        default=8.0,
        help="seconds between downloads, jittered by a quarter either way (default: 8)",
    )
    parser.add_argument("--limit", type=int, help="stop after this many packs (the most popular)")
    parser.add_argument(
        "--sort", default="Popular", choices=["Popular", "Latest", "Alphabet", "Downloads"]
    )
    parser.add_argument("--dry-run", action="store_true", help="list and total, download nothing")
    args = parser.parse_args()

    wanted = MAPS if args.maps.strip().lower() == "all" else [m.strip() for m in args.maps.split(",")]
    unknown = [m for m in wanted if m not in MAPS]
    if unknown:
        die(f"Not a map name: {', '.join(unknown)}\nKnown: {', '.join(MAPS)}")

    attribute = f"{args.resolution}-{args.format}"
    suffix = args.format.lower()

    print(f"Asking ambientCG for the {args.category} materials…")
    assets = catalogue(args.category, args.sort)
    if not assets:
        die(f"No materials in category {args.category!r}. The category names are the ones in the\n"
            f"sidebar at https://ambientcg.com/list — Ground, Grass, Rock, Concrete, and so on.")
    if args.limit:
        assets = assets[: args.limit]

    args.out.mkdir(parents=True, exist_ok=True)
    if not args.no_packs:
        args.packs.mkdir(parents=True, exist_ok=True)

    # Four buckets, decided before anything is downloaded so the plan can be printed. The pack on
    # disk is what "already have it" means, not the unpacked maps: a run that keeps its zips has to
    # end with every zip there, or the next `--maps` would have to pay for the ones it is missing.
    # A zip of the wrong size is a download that was cut off before `.part` existed, and is fetched
    # again.
    fetch, local, done, missing = [], [], [], []
    for asset in assets:
        name = f"{asset['assetId']}_{attribute}"
        unpacked = all((args.out / f"{name}_{m}.{suffix}").exists() for m in wanted)
        download = zip_for(asset, attribute)
        if download is None:
            missing.append(asset["assetId"])
            continue
        archive = args.packs / download["fileName"]
        held = archive.exists() and archive.stat().st_size == download["size"]
        if held or (args.no_packs and unpacked):
            (done if unpacked else local).append((name, archive, download))
        else:
            fetch.append((name, archive, download))

    traffic = sum(d["size"] for _, _, d in fetch)
    print(
        f"{len(assets)} materials: {len(fetch)} to download ({traffic / 1e9:.2f} GB), "
        f"{len(local)} to unpack from {args.packs.name}/, {len(done)} already done, "
        f"{len(missing)} with no {attribute} download."
    )
    if missing:
        print("  no download: " + ", ".join(missing))
    if args.dry_run:
        for name, _, download in fetch:
            print(f"  {name}  {download['size'] / 1e6:6.1f} MB")
        return
    if not fetch and not local:
        print("Nothing to do.")
        return
    print(f"Keeping {', '.join(wanted)} out of each.")
    if fetch:
        print(f"At least {(len(fetch) * args.pause) / 60:.0f} min of pauses alone.")
    print()

    kept, todo = 0, local + fetch
    for index, (name, archive, download) in enumerate(todo, 1):
        held = archive.exists() and archive.stat().st_size == download["size"]
        head = f"[{index}/{len(todo)}] {name}"
        if held:
            print(f"{head}  (have the pack)", end="", flush=True)
        else:
            print(f"{head}  ({download['size'] / 1e6:.1f} MB)", end="", flush=True)
            try:
                get(download["downloadLink"], into=archive)
            except (urllib.error.HTTPError, RuntimeError) as error:
                print(f"\n    skipped: {error}")
                continue

        written = unpack(archive, name, wanted, suffix, args.out)
        kept += len(written)
        print(f" -> {', '.join(p.name for p in written) or 'nothing'}")
        if args.no_packs:
            archive.unlink(missing_ok=True)

        if not held and index < len(todo):
            time.sleep(args.pause * random.uniform(0.75, 1.25))

    print(f"\nDone: {kept} files in {args.out}.")
    if not args.no_packs:
        on_disk = sum(p.stat().st_size for p in args.packs.glob("*.zip"))
        print(f"The packs stay in {args.packs} ({on_disk / 1e9:.2f} GB) — re-run with --maps all to "
              f"unpack more of\nwhat is in them without downloading anything again.")
    print(f"All CC0. A layer reads one by name, without the map suffix: texture = \"{todo[0][0]}\".")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nStopped. Re-run to continue: the packs already downloaded are not fetched again.")
        sys.exit(130)
